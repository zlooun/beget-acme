{
  "name": "beget-acme",
  "private": true,
  "version": "0.2.0-beta.1",
  "description": "Safe DNS-01 wildcard certificate automation for Beget DNS",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "bin": {
    "beget-acme": "dist/cli.js"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node scripts/clean.mjs dist-test && tsc -p tsconfig.test.json && node --test \"dist-test/test/**/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "start": "node dist/cli.js",
    "doctor": "node --env-file=.env dist/cli.js doctor",
    "status": "node --env-file=.env dist/cli.js status",
    "package:check": "node scripts/check-package.mjs",
    "coverage": "node scripts/clean.mjs dist-test && tsc -p tsconfig.test.json && node --test --experimental-test-coverage \"dist-test/test/**/*.test.js\""
  },
  "dependencies": {
    "@peculiar/x509": "2.2.0",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "files": [
    "dist/",
    ".env.example",
    "README.md",
    "docs/",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples/"
  ]
}
