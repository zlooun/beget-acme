# Required: one certificate containing these exact DNS identities.
ACME_DOMAINS=example.com,*.example.com
ACME_EMAIL=admin@example.com
BEGET_USERNAME=your_api_login
BEGET_PASSWORD=your_api_password

# DNS replacement consent is disabled by default (false).
# Set to true only after inspecting the dedicated challenge names in the Beget panel.
# A matching approval already saved by setup/run remains valid when this is false.
ACME_ACCEPT_DNS_REPLACEMENT=false

# Optional Compose host paths. Missing directories are created automatically.
CERTIFICATES_DIR=./output
STATE_DIR=./state

# Optional non-root mode; defaults to root (0:0) when omitted.
# Set both IDs and prepare directory ownership before starting as non-root.
# APP_UID=10001
# APP_GID=10001

# Optional: staging for a continuously running test service; production is the default.
# ACME_ENVIRONMENT=production

# Optional: explicit managed zones if automatic discovery cannot establish control.
# BEGET_ZONES=example.com

# Native Node.js paths (Compose sets the paths inside the container).
# ACME_OUTPUT_DIR=./output
# ACME_STATE_DIR=./state

# File-based credentials are supported instead of the direct values above.
# BEGET_USERNAME_FILE=/run/secrets/beget_username
# BEGET_PASSWORD_FILE=/run/secrets/beget_password

# Omit the renewal threshold to use one third of the certificate lifetime.
# ACME_RENEW_BEFORE_DAYS=10
# Successful checks wait 12 hours; failed checks wait 1 hour.
# ACME_SCHEDULE_INTERVAL_MS=43200000
# ACME_RETRY_INTERVAL_MS=3600000

# Recheck normal TLS negotiation 7 days after a successful TLS 1.2 fallback.
# ACME_TLS_FALLBACK_TTL_MS=604800000
