# Copy to .env in the repository root, or merge these settings into your existing .env.
BEGET_ACME_IMAGE=zloun/beget-acme:0.2.1
NGINX_IMAGE=nginx/nginx-unprivileged:1.31.7-alpine3.24
ACME_DOMAINS=example.com,*.example.com
ACME_EMAIL=admin@example.com
BEGET_USERNAME=your_api_login
BEGET_PASSWORD=your_api_password

STATE_DIR=./state
CERTIFICATES_DIR=./output
APP_UID=10001
TLS_GID=10002
NGINX_UID=10003
NGINX_GID=10003

NGINX_CONFIG_PATH=./examples/nginx-unprivileged.conf
NGINX_RELOAD_SCRIPT_PATH=./examples/start-with-reload.sh
NGINX_RELOAD_INTERVAL_SECONDS=3600
HTTPS_PORT=443

# Disabled by default; set to true only after inspecting dedicated DNS names in Beget.
ACME_ACCEPT_DNS_REPLACEMENT=false
